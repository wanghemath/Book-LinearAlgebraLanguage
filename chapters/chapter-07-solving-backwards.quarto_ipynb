        "### Exercise 2: Create a System from a Known Solution"
      ],
      "id": "8335a5b8"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "A = np.array([\n",
        "    [3, 1],\n",
        "    [2, 4]\n",
        "], dtype=float)\n",
        "\n",
        "x_true = np.array([2, 5], dtype=float)\n",
        "b = A @ x_true\n",
        "\n",
        "x_recovered = np.linalg.solve(A, b)\n",
        "\n",
        "print(\"b:\", b)\n",
        "print(\"recovered:\", x_recovered)"
      ],
      "id": "73e08655",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Exercise 3: Compare Exact and Inconsistent Targets"
      ],
      "id": "2f77a93d"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "A = np.array([\n",
        "    [1, 1],\n",
        "    [2, 2]\n",
        "], dtype=float)\n",
        "\n",
        "for b in [np.array([3, 6], dtype=float), np.array([3, 7], dtype=float)]:\n",
        "    x_hat, residuals, rank, s = np.linalg.lstsq(A, b, rcond=None)\n",
        "    print(\"b =\", b)\n",
        "    print(\"x_hat =\", x_hat)\n",
        "    print(\"A @ x_hat =\", A @ x_hat)\n",
        "    print(\"residual norm =\", np.linalg.norm(b - A @ x_hat))\n",
        "    print()"
      ],
      "id": "c56a1d00",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
