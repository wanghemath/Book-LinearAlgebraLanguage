      "source": [
        "### Exercise 5: High-Dimensional Recovery"
      ],
      "id": "64e3816f"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "np.random.seed(12)\n",
        "\n",
        "n = 150\n",
        "A = np.random.randn(n, n)\n",
        "x_true = np.random.randn(n)\n",
        "b = A @ x_true\n",
        "\n",
        "x_hat = np.linalg.solve(A, b)\n",
        "\n",
        "print(\"relative error:\", np.linalg.norm(x_hat - x_true) / np.linalg.norm(x_true))\n",
        "print(\"relative residual:\", np.linalg.norm(A @ x_hat - b) / np.linalg.norm(b))"
      ],
      "id": "bbc0627e",
      "execution_count": null,
      "outputs": []
    },
