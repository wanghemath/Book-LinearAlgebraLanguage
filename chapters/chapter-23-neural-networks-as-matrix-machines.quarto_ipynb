    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Exercise 4: visualize a hidden layer in two dimensions"
      ],
      "id": "bcc73916"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def tiny_hidden_features(points):\n",
        "    W = np.array([[1, 1], [1, -1], [-1, 1]], dtype=float)\n",
        "    b = np.array([-0.5, 0.0, 0.0])\n",
        "    return relu(points @ W.T + b)\n",
        "\n",
        "rng = np.random.default_rng(10)\n",
        "points = rng.normal(size=(300, 2))\n",
        "H = tiny_hidden_features(points)\n",
        "\n",
        "plt.figure(figsize=(6, 5))\n",
        "plt.scatter(H[:, 0], H[:, 1], c=H[:, 2], s=25, alpha=0.8)\n",
        "plt.xlabel(\"hidden feature 1\")\n",
        "plt.ylabel(\"hidden feature 2\")\n",
        "plt.title(\"A Hidden Representation of 2D Points\")\n",
        "plt.colorbar(label=\"hidden feature 3\")\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.show()"
      ],
      "id": "b8479029",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
