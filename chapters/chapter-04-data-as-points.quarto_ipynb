        "    [3.5, 1.2, 1.3, 20],\n",
        "    [0.8, 4.0, 0.4, 9],\n",
        "    [2.9, 1.8, 1.0, 17]\n",
        "])\n",
        "\n",
        "X.shape"
      ],
