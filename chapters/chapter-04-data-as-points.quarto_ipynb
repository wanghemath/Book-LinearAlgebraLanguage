      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Exercise 4: Compare Distances Before and After Scaling"
      ],
      "id": "6049ff3e"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "a = np.array([1800, 500000])\n",
        "b = np.array([1900, 510000])\n",
        "\n",
        "raw_distance = np.linalg.norm(a - b)\n",
        "\n",
        "A = np.array([\n",
        "    [1800, 500000],\n",
        "    [1900, 510000],\n",
        "    [2500, 700000],\n",
        "    [1200, 350000]\n",
        "])\n",
        "A_standardized = (A - A.mean(axis=0)) / A.std(axis=0)\n",
        "scaled_distance = np.linalg.norm(A_standardized[0] - A_standardized[1])\n",
        "\n",
        "raw_distance, scaled_distance"
      ],
      "id": "1c92cb68",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Exercise 5: Generate and Plot Clusters"
      ],
      "id": "4897ecf8"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "np.random.seed(52)\n",
        "\n",
        "cluster_1 = np.random.normal(loc=[0, 0], scale=0.4, size=(50, 2))\n",
        "cluster_2 = np.random.normal(loc=[3, 2], scale=0.4, size=(50, 2))\n",
        "cluster_3 = np.random.normal(loc=[1, 4], scale=0.4, size=(50, 2))\n",
        "\n",
        "X_clusters = np.vstack([cluster_1, cluster_2, cluster_3])\n",
        "\n",
        "plt.figure(figsize=(7, 6))\n",
        "plt.scatter(X_clusters[:, 0], X_clusters[:, 1], alpha=0.75)\n",
        "plt.xlabel(\"Feature 1\")\n",
        "plt.ylabel(\"Feature 2\")\n",
        "plt.title(\"Synthetic Clusters\")\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.show()"
      ],
      "id": "3d4c788b",
      "execution_count": null,
      "outputs": []
    },
    {
